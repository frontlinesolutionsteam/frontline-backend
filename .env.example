# ── Pilot: merchant-generated API token auth (no OAuth) ──────────────────────
# The simplest path for a single pilot restaurant. The merchant generates this
# themselves in their Clover Dashboard under Account & Setup > API Tokens, with
# permissions: Orders read/write, Inventory read, Customers read/write.
#
# NOTE: this is the Platform REST API token, NOT the "Ecommerce > API Tokens"
# one. Ecommerce tokens talk to scl-sandbox.dev.clover.com and handle payments;
# only a Platform token can create an order in the merchant's order queue via
# /v3/merchants/{mId}/atomic_order/orders.
#
# These two are a bootstrap escape hatch so `pnpm test-clover-order` runs with
# no database. Real per-client tokens are stored encrypted in clover_api_tokens
# via `pnpm set-clover-credentials`.
CLOVER_PILOT_MERCHANT_ID=
CLOVER_PILOT_API_TOKEN=
# Optional: the merchant's "Online Order" order type id, so tickets don't print
# as dine-in. Per-merchant value; find it at /v3/merchants/{mId}/order_types.
CLOVER_PILOT_ORDER_TYPE_ID=

# ── Pilot: Ecommerce API credentials (payment collection) ────────────────────
# A SEPARATE credential pair from the Platform token above -- generated in the
# merchant's Clover Dashboard under Settings > Ecommerce > API Tokens, choosing
# "Hosted iFrame + API/SDK" as the integration type. The public key is safe to
# expose client-side (the storefront's iframe needs it); the private token is
# server-side only, used to charge/refund via scl-sandbox.dev.clover.com.
CLOVER_PILOT_ECOMMERCE_PUBLIC_KEY=
CLOVER_PILOT_ECOMMERCE_PRIVATE_TOKEN=

# ── Clover private app (sandbox) — OAuth path, not needed for the pilot ──────
CLOVER_APP_ID=PH41PZJW0TE1J
CLOVER_APP_SECRET=
# apisandbox.dev.clover.com is used for both REST API calls and OAuth token
# exchange/refresh; sandbox.dev.clover.com is used only for the authorize redirect.
CLOVER_API_HOST=apisandbox.dev.clover.com
CLOVER_AUTHORIZE_HOST=sandbox.dev.clover.com
CLOVER_SANDBOX_MERCHANT_ID=YT39NHT366D21

# Must exactly match the redirect URI registered in the Clover Developer Dashboard
# for this app's Alternate Launch Path.
CLOVER_REDIRECT_URI=http://localhost:3000/clover/oauth/callback

# Postgres
DATABASE_URL=postgres://localhost:5432/frontline_dev

# Redis (menu availability cache)
REDIS_URL=redis://localhost:6379

# "Clover Auth Code" shown in the app's Developer Dashboard settings, used to
# validate the X-Clover-Auth header on inbound webhook POSTs. Fill in once the
# webhook subscription is configured.
CLOVER_WEBHOOK_SECRET=

# 32-byte key (base64) used for AES-256-GCM encryption of stored Clover tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

PORT=3000

# Origin of the Next.js admin app, allowed via CORS on /admin/*
ADMIN_APP_ORIGIN=http://localhost:3001

# Origin of the Next.js storefront app, allowed via CORS on /website/*
STOREFRONT_APP_ORIGIN=http://localhost:3002
